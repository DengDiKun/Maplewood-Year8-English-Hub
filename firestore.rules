rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasActiveRole(role) {
      return request.auth != null
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function studentEnrollmentIsActive(profile) {
      return profile.classId is string && profile.studentId is string
             && get(/databases/$(database)/documents/classes/$(profile.classId)).data.active == true
             && get(/databases/$(database)/documents/classes/$(profile.classId)/students/$(profile.studentId)).data.active == true
             && get(/databases/$(database)/documents/classes/$(profile.classId)/students/$(profile.studentId)).data.authUid == request.auth.uid;
    }


    function ownsEnrollment(classId, studentId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return hasActiveRole('student') && profile.classId == classId && profile.studentId == studentId
             && studentEnrollmentIsActive(profile);
    }
    function canReviewResponses(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId))
             && (hasActiveRole('admin') || (hasActiveRole('teacher')
                 && get(/databases/$(database)/documents/classes/$(classId)).data.active == true
                 && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUids.hasAny([request.auth.uid])));
    }
    function validAnswer(answer, status) {
      return answer is string && answer.size() <= 4000
             && (status == 'draft' || answer.matches('(?s).*\\S.*'));
    }
    function responseSize(activityId) {
      return activityId in ["unit-2-mountains-v1","unit-3-oak-island-v1","unit-6-below-ground-v1","unit-7-ochuko-v1","unit-8-life-choices-v1","unit-8-decisions-v1","extra-reading-exam-v1","extra-haze-v1"] ? {"unit-2-mountains-v1":4,"unit-3-oak-island-v1":4,"unit-6-below-ground-v1":1,"unit-7-ochuko-v1":4,"unit-8-life-choices-v1":27,"unit-8-decisions-v1":27,"extra-reading-exam-v1":35,"extra-haze-v1":32}[activityId]
             : activityId == 'unit-8-merchant-v1' ? 12
             : activityId == 'writers-effect-v1' ? 11
             : (activityId.matches('unit-[1-6]-reading-[1-6]-v1')
                || activityId.matches('unit-[78]-reading-[1-3]-v1')
                || activityId.matches('unit-9-reading-[1-5]-v1')) ? 3
             : activityId.matches('unit-[1-9]-(writing|speaking|language)-v1') ? 1 : 0;
    }
    function submittedActivity(classId, studentId, activityId) {
      return activityId.matches('[a-z0-9][a-z0-9-]{0,63}')
             && exists(/databases/$(database)/documents/classes/$(classId)/students/$(studentId))
             && get(/databases/$(database)/documents/classes/$(classId)/students/$(studentId)/responses/$(activityId)).data.status == 'submitted';
    }
    function validMarking(data, classId, studentId, activityId) {
      return data.keys().hasAll(['version', 'score', 'maxScore', 'feedback', 'reviewerUid', 'updatedAt', 'submissionUpdatedAt'])
             && data.keys().hasOnly(['version', 'score', 'maxScore', 'feedback', 'reviewerUid', 'updatedAt', 'submissionUpdatedAt'])
             && data.version == 1
             && data.score is int && data.maxScore is int
             && data.maxScore >= 1 && data.maxScore <= 1000
             && data.score >= 0 && data.score <= data.maxScore
             && data.feedback is string && data.feedback.size() <= 4000
             && data.reviewerUid == request.auth.uid
             && data.updatedAt == request.time
             && data.submissionUpdatedAt is timestamp
             && data.submissionUpdatedAt == get(/databases/$(database)/documents/classes/$(classId)/students/$(studentId)/responses/$(activityId)).data.updatedAt;
    }
    function validMerchantChoices(answers) {
      return answers.q1 in ["", "He values appearance and wealth.", "He is nervous about losing Portia.", "He believes he deserves Portia."]
             && answers.q2 in ["", "Appearances can be misleading.", "Love is a reward for people who are already important.", "Only confident people make good choices."]
             && answers.q3 in ["", "He values appearance and wealth.", "He is nervous about losing Portia.", "He believes he deserves Portia."]
             && answers.q4 in ["", "People who think too highly of themselves may be foolish.", "Gold always brings happiness.", "Choices should be made quickly."]
             && answers.q5 in ["", "He values appearance and wealth.", "He is anxious because the wrong choice could cost him Portia.", "He believes he deserves Portia."]
             && answers.q6 in ["", "Choose according to appearance.", "Do not judge only by outward appearance.", "Risk is always a bad idea."]
             && answers.q9 in ["", "A It is clear that Portia wants Bassanio to succeed.", "B Although the men have a choice, Portia does not.", "C The extract shows that love is more important than money."]
             && answers.q10 in ["", "\u201cI pray you, tarry: pause a day or two / Before you hazard\u2026\u201d", "\u201cfor, in choosing wrong, / I lose your company.\u201d", "\u201cLet me choose / For as I am, I live upon the rack.\u201d", "\u201cAll that glitters is not gold\u201d", "\u201cYou that choose not by the view, / Chance as fair and choose as true!\u201d", "\u201cI will assume desert.\u201d"]
             && answers.q12 in ["", "💰 Morocco shows that people can be distracted by appearance and wealth.", "🪞 Aragon shows that pride can distort a person’s judgement.", "❤️ Bassanio shows that genuine love looks beyond outward appearance."];
    }
    function optionalAnswers(activityId) {
      return activityId in ["unit-8-life-choices-v1","unit-8-decisions-v1"] ? {"unit-8-life-choices-v1":["q20","q21","q22","q23","q24","q25","q26","q27"],"unit-8-decisions-v1":["q19","q20","q21","q22","q23","q24","q25","q26"]}[activityId] : [];
    }
    function validRichChoices(answers, activityId) {
      return (activityId != 'unit-8-life-choices-v1' || ((answers.q16 == '' || answers.q16 in ["Completed","Not yet"])
                 && (answers.q17 == '' || answers.q17 in ["Consider your values, options and possible consequences.","Choose immediately so you do not have to think.","Always copy what other people choose."])
                 && (answers.q18 == '' || answers.q18 in ["different options may lead to different consequences.","every choice has exactly the same result.","feelings never affect decisions."])
                 && (answers.q19 == '' || answers.q19 in ["uncertainty or careful thought.","that there is no choice to make.","that the decision is unimportant."])
                 && (answers.q20 == '' || answers.q20 in ["Checked","Not checked"])
                 && (answers.q21 == '' || answers.q21 in ["Checked","Not checked"])
                 && (answers.q22 == '' || answers.q22 in ["Checked","Not checked"])
                 && (answers.q23 == '' || answers.q23 in ["Checked","Not checked"])
                 && (answers.q24 == '' || answers.q24 in ["Checked","Not checked"])
                 && (answers.q25 == '' || answers.q25 in ["hesitation","uncertainty","curiosity","hesitation\nuncertainty","hesitation\ncuriosity","uncertainty\ncuriosity","hesitation\nuncertainty\ncuriosity"])
                 && (answers.q26 == '' || answers.q26 in ["uncertainty","realism","regret","uncertainty\nrealism","uncertainty\nregret","realism\nregret","uncertainty\nrealism\nregret"])
                 && (answers.q27 == '' || answers.q27 in ["reflection","confidence","acceptance","reflection\nconfidence","reflection\nacceptance","confidence\nacceptance","reflection\nconfidence\nacceptance"])))
             && (activityId != 'unit-8-decisions-v1' || ((answers.q15 == '' || answers.q15 in ["Completed","Not yet"])
                 && (answers.q16 == '' || answers.q16 in ["Consider the options and possible outcomes.","Ignore the consequences.","Choose the first idea every time."])
                 && (answers.q17 == '' || answers.q17 in ["They may offer another perspective or useful information.","It guarantees there is only one correct answer.","It means you never need to think for yourself."])
                 && (answers.q18 == '' || answers.q18 in ["evaluating ideas before choosing.","refusing to listen to anyone.","avoiding every decision."])
                 && (answers.q19 == '' || answers.q19 in ["Checked","Not checked"])
                 && (answers.q20 == '' || answers.q20 in ["Checked","Not checked"])
                 && (answers.q21 == '' || answers.q21 in ["Checked","Not checked"])
                 && (answers.q22 == '' || answers.q22 in ["Checked","Not checked"])
                 && (answers.q23 == '' || answers.q23 in ["Checked","Not checked"])
                 && (answers.q24 == '' || answers.q24 in ["Checked","Not checked"])
                 && (answers.q25 == '' || answers.q25 in ["Checked","Not checked"])
                 && (answers.q26 == '' || answers.q26 in ["Checked","Not checked"])
                 && (answers.q27 == '' || answers.q27 in ["Rich people should share their wealth with poor people.","The whole world should stop eating meat.","Cars should be banned.","Children should start school at the age of eight."])))
             && (activityId != 'extra-reading-exam-v1' || ((answers.q1 == '' || answers.q1 in ["The school wanted every student to study three extra hours.","Some students did not have suitable study conditions at home.","Teachers wanted to replace homework with library lessons.","Parents complained that the library closed too late."])
                 && (answers.q2 == '' || answers.q2 in ["The silent upstairs area","The downstairs group-work area","The supervised entrance","Only the help desk"])
                 && (answers.q3 == '' || answers.q3 in ["Fewer students attended.\nThe average student stayed longer.","Fewer students attended.\nMore students attended.","Fewer students attended.\nThe average student stayed for less time.","The average student stayed longer.\nMore students attended.","The average student stayed longer.\nThe average student stayed for less time.","More students attended.\nThe average student stayed for less time.","Fewer students attended.","The average student stayed longer.","More students attended.","The average student stayed for less time."])
                 && (answers.q4 == '' || answers.q4 in ["Students had forgotten where the library was.","The first excitement about trying something new had decreased.","Students were no longer interested in examinations.","The school had stopped advertising the trial."])
                 && (answers.q5 == '' || answers.q5 in ["Students needed ways to get home after normal buses left.\nStudents needed access to water or simple food.","Students needed ways to get home after normal buses left.\nThe library did not have enough books.","Students needed ways to get home after normal buses left.\nTeachers refused to help students.","Students needed access to water or simple food.\nThe library did not have enough books.","Students needed access to water or simple food.\nTeachers refused to help students.","The library did not have enough books.\nTeachers refused to help students.","Students needed ways to get home after normal buses left.","Students needed access to water or simple food.","The library did not have enough books.","Teachers refused to help students."])
                 && (answers.q6 == '' || answers.q6 in ["To support different ways of studying without them disturbing one another","To separate teachers from students","To make the building look larger","To punish students who spoke"])
                 && (answers.q7 == '' || answers.q7 in ["The trial failed because attendance was lower.","A smaller but more committed group was using the library for longer.","Students had become slower at completing work.","Most students stayed for exactly seventy-one minutes."])
                 && (answers.q8 == '' || answers.q8 in ["All schools should keep libraries open every night.","Students work best only when they are supervised.","Extra study support works best when it is designed around students\u2019 real needs.","Libraries should replace studying at home."])
                 && (answers.q9 == '' || answers.q9 in ["A","B","C","D"])
                 && (answers.q10 == '' || answers.q10 in ["A","B","C","D"])
                 && (answers.q11 == '' || answers.q11 in ["A","B","C","D"])
                 && (answers.q12 == '' || answers.q12 in ["A","B","C","D"])
                 && (answers.q13 == '' || answers.q13 in ["A","B","C","D"])
                 && (answers.q14 == '' || answers.q14 in ["A","B","C","D"])
                 && (answers.q15 == '' || answers.q15 in ["A","B","C","D"])
                 && (answers.q16 == '' || answers.q16 in ["A","B","C","D"])
                 && (answers.q17 == '' || answers.q17 in ["A","B","C","D"])
                 && (answers.q18 == '' || answers.q18 in ["A","B","C","D"])
                 && (answers.q19 == '' || answers.q19 in ["Attention may weaken even while the student remains at the desk.\nCareless mistakes may become more common.","Attention may weaken even while the student remains at the desk.\nBooks become harder to read after one hour.","Attention may weaken even while the student remains at the desk.\nThe brain completely stops forming memories.","Careless mistakes may become more common.\nBooks become harder to read after one hour.","Careless mistakes may become more common.\nThe brain completely stops forming memories.","Books become harder to read after one hour.\nThe brain completely stops forming memories.","Attention may weaken even while the student remains at the desk.","Careless mistakes may become more common.","Books become harder to read after one hour.","The brain completely stops forming memories."])
                 && (answers.q20 == '' || answers.q20 in ["A break deletes everything the learner has studied.","A short pause can interrupt tired concentration and help the learner return with renewed attention.","Students should restart every task from the beginning.","Electronic devices should be restarted during revision."])
                 && (answers.q21 == '' || answers.q21 in ["It introduces lots of new information that may continue competing for attention.","The internet may be too slow.","Friends may dislike the student\u2019s posts.","Using social media is always forbidden."])
                 && (answers.q22 == '' || answers.q22 in ["Watching several short videos","Starting a new online game","Stretching or drinking water","Reading dozens of messages"])
                 && (answers.q23 == '' || answers.q23 in ["It can help the learner return with better attention.\nIt can make repeated mistakes easier to notice.","It can help the learner return with better attention.\nIt allows the learner to avoid difficult work permanently.","It can help the learner return with better attention.\nIt guarantees a perfect score.","It can make repeated mistakes easier to notice.\nIt allows the learner to avoid difficult work permanently.","It can make repeated mistakes easier to notice.\nIt guarantees a perfect score.","It allows the learner to avoid difficult work permanently.\nIt guarantees a perfect score.","It can help the learner return with better attention.","It can make repeated mistakes easier to notice.","It allows the learner to avoid difficult work permanently.","It guarantees a perfect score."])
                 && (answers.q24 == '' || answers.q24 in ["Every learner must take a break at exactly the same time.","Some break activities help attention recover more effectively than others.","Long breaks are always better than short breaks.","Breaks only work for strong students."])
                 && (answers.q25 == '' || answers.q25 in ["Make deliberate choices about how and when to continue working.\nPay attention to focus and notice mistakes in your own work.","Make deliberate choices about how and when to continue working.\nMeasure success only by the number of hours at the desk.","Make deliberate choices about how and when to continue working.\nFollow one perfect study schedule used by everyone.","Pay attention to focus and notice mistakes in your own work.\nMeasure success only by the number of hours at the desk.","Pay attention to focus and notice mistakes in your own work.\nFollow one perfect study schedule used by everyone.","Measure success only by the number of hours at the desk.\nFollow one perfect study schedule used by everyone.","Make deliberate choices about how and when to continue working.","Pay attention to focus and notice mistakes in your own work.","Measure success only by the number of hours at the desk.","Follow one perfect study schedule used by everyone."])
                 && (answers.q26 == '' || answers.q26 in ["unused","dangerous","crowded","painted"])
                 && (answers.q27 == '' || answers.q27 in ["weight","rain","noise","heat"])
                 && (answers.q28 == '' || answers.q28 in ["safety rails","doors","lights","shelves"])
                 && (answers.q29 == '' || answers.q29 in ["tanks","ponds","classrooms","pipes"])
                 && (answers.q30 == '' || answers.q30 in ["soil moisture","traffic","only air temperature","homework"])
                 && (answers.q31 == '' || answers.q31 in ["insects","parents","only birds","teachers"])
                 && (answers.q32 == '' || answers.q32 in ["herbs","tomatoes only","flowers","water"])
                 && (answers.q33 == '' || answers.q33 in ["wind","shade","rain","noise"])
                 && (answers.q34 == '' || answers.q34 in ["holidays","assemblies","exams","lunches"])
                 && (answers.q35 == '' || answers.q35 in ["climate","uniform","building colour","timetable"])))
             && (activityId != 'extra-haze-v1' || ((answers.q4 == '' || answers.q4 in ["Yong En","Yu Chen","Teacher James","His father"])
                 && (answers.q5 == '' || answers.q5 in ["Yu Chen","Yong En","Teacher James","His father"])
                 && (answers.q14 == '' || answers.q14 in ["Schools may reduce outdoor activities.\nFlights can be delayed.","Schools may reduce outdoor activities.\nBooks become difficult to print.","Schools may reduce outdoor activities.\nSchool uniforms change colour.","Flights can be delayed.\nBooks become difficult to print.","Flights can be delayed.\nSchool uniforms change colour.","Books become difficult to print.\nSchool uniforms change colour.","Schools may reduce outdoor activities.","Flights can be delayed.","Books become difficult to print.","School uniforms change colour."])
                 && (answers.q15 == '' || answers.q15 in ["Governments\nCompanies\nCommunities","Governments\nCompanies\nTourists only","Governments\nCommunities\nTourists only","Companies\nCommunities\nTourists only","Governments\nCompanies","Governments\nCommunities","Governments\nTourists only","Companies\nCommunities","Companies\nTourists only","Communities\nTourists only","Governments","Companies","Communities","Tourists only"])
                 && (answers.q21 == '' || answers.q21 in ["heavy rain","thick, unclear air","a crowded car park","cold weather"])
                 && (answers.q22 == '' || answers.q22 in ["excited","amused","concerned","proud"])
                 && (answers.q23 == '' || answers.q23 in ["metaphor","simile","repetition","onomatopoeia"])
                 && (answers.q24 == '' || answers.q24 in ["to tell a funny story","to blame one person for haze","to explain haze, its effects and possible responses","to give instructions for travelling"])
                 && (answers.q25 == '' || answers.q25 in ["Paragraph 1","Paragraph 2","Paragraph 3","Paragraph 4"])
                 && (answers.q26 == '' || answers.q26 in ["It signals a change from problems towards solutions.","It introduces another example of a fire.","It describes a character.","It repeats paragraph 2."])
                 && (answers.q27 == '' || answers.q27 in ["visibility","peatlands","borders","responsibility","smoke","outdoor"])
                 && (answers.q28 == '' || answers.q28 in ["visibility","peatlands","borders","responsibility","smoke","outdoor"])
