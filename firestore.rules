             && (size < 26 || validAnswer(data.answers.q26, optional.hasAny(['q26']) ? 'draft' : data.status))
             && (size < 27 || validAnswer(data.answers.q27, optional.hasAny(['q27']) ? 'draft' : data.status))
             && (size < 28 || validAnswer(data.answers.q28, optional.hasAny(['q28']) ? 'draft' : data.status))
             && (size < 29 || validAnswer(data.answers.q29, optional.hasAny(['q29']) ? 'draft' : data.status))
             && (size < 30 || validAnswer(data.answers.q30, optional.hasAny(['q30']) ? 'draft' : data.status))
             && (size < 31 || validAnswer(data.answers.q31, optional.hasAny(['q31']) ? 'draft' : data.status))
             && (size < 32 || validAnswer(data.answers.q32, optional.hasAny(['q32']) ? 'draft' : data.status))
             && (size < 33 || validAnswer(data.answers.q33, optional.hasAny(['q33']) ? 'draft' : data.status))
             && (size < 34 || validAnswer(data.answers.q34, optional.hasAny(['q34']) ? 'draft' : data.status))
             && (size < 35 || validAnswer(data.answers.q35, optional.hasAny(['q35']) ? 'draft' : data.status))
             && (activityId != 'unit-8-merchant-v1' || validMerchantChoices(data.answers))
             && validRichChoices(data.answers, activityId)
             && validRichSubmission(data.answers, activityId, data.status);
    }
    match /users/{userId} {
      allow get: if request.auth != null
                 && request.auth.uid == userId
                 && resource.data.active == true
                 && (resource.data.role != 'student' || studentEnrollmentIsActive(resource.data));

      allow list, create, update, delete: if false;
    }

    match /classes/{classId} {
      // Administrators can review every class, including inactive classes.
      // Teachers can read only active classes explicitly assigned to their UID.
      allow get, list: if hasActiveRole('admin')
                       || (hasActiveRole('teacher')
                           && resource.data.active == true
                           && resource.data.teacherUids.hasAny([request.auth.uid]));

      match /students/{studentId} {
        // Roster access uses the current parent class, never a client role flag.
        allow get, list: if exists(/databases/$(database)/documents/classes/$(classId))
                         && (hasActiveRole('admin')
                             || (hasActiveRole('teacher')
                                 && get(/databases/$(database)/documents/classes/$(classId)).data.active == true
                                 && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUids.hasAny([request.auth.uid])));
        allow create, update, delete: if false;
        match /responses/{activityId} {
          allow get: if responseSize(activityId) > 0 && request.auth != null
                     && (ownsEnrollment(classId, studentId) || canReviewResponses(classId));
          allow create: if responseSize(activityId) > 0 && request.auth != null
                        && ownsEnrollment(classId, studentId) && validResponse(request.resource.data, activityId);
          allow update: if responseSize(activityId) > 0 && request.auth != null
                        && ownsEnrollment(classId, studentId) && resource.data.status == 'draft'
                        && validResponse(request.resource.data, activityId);
          allow list, delete: if false;
        }
        // Shared marking storage for submitted activities in every unit.
        // Only the existing response rules decide which activities students can submit.
        match /markingDrafts/{activityId} {
          allow get: if request.auth != null && canReviewResponses(classId)
                     && submittedActivity(classId, studentId, activityId);
          allow create, update: if request.auth != null && canReviewResponses(classId)
                                && submittedActivity(classId, studentId, activityId)
                                && validMarking(request.resource.data, classId, studentId, activityId);
          allow list, delete: if false;
        }
        match /feedback/{activityId} {
          allow get: if request.auth != null && submittedActivity(classId, studentId, activityId)
                     && (canReviewResponses(classId)
                         || (ownsEnrollment(classId, studentId)
                             && (!exists(/databases/$(database)/documents/classes/$(classId)/students/$(studentId)/feedback/$(activityId))
                                 || resource.data.submissionUpdatedAt == get(/databases/$(database)/documents/classes/$(classId)/students/$(studentId)/responses/$(activityId)).data.updatedAt)));
          allow create, update: if request.auth != null && canReviewResponses(classId)
                                && submittedActivity(classId, studentId, activityId)
                                && validMarking(request.resource.data, classId, studentId, activityId);
          allow list, delete: if false;
        }
      }

      // Class creation and assignment changes still use the Firebase Console.
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
