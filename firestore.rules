rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasActiveRole(role) {
      return request.auth != null
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function studentEnrollmentIsActive(profile) {
      return profile.classId is string && profile.studentId is string
             && get(/databases/$(database)/documents/classes/$(profile.classId)).data.active == true
             && get(/databases/$(database)/documents/classes/$(profile.classId)/students/$(profile.studentId)).data.active == true
             && get(/databases/$(database)/documents/classes/$(profile.classId)/students/$(profile.studentId)).data.authUid == request.auth.uid;
    }


    function ownsEnrollment(classId, studentId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return hasActiveRole('student') && profile.classId == classId && profile.studentId == studentId
             && studentEnrollmentIsActive(profile);
    }
    function canReviewResponses(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId))
             && (hasActiveRole('admin') || (hasActiveRole('teacher')
                 && get(/databases/$(database)/documents/classes/$(classId)).data.active == true
                 && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUids.hasAny([request.auth.uid])));
    }
    function validAnswer(answer, status) {
      return answer is string && answer.size() <= 4000
             && (status == 'draft' || answer.matches('(?s).*\\S.*'));
    }
    function validResponse(data) {
      return data.keys().hasAll(['version', 'status', 'answers', 'updatedAt'])
             && data.keys().hasOnly(['version', 'status', 'answers', 'updatedAt'])
             && data.version == 1 && data.status in ['draft', 'submitted']
             && data.updatedAt == request.time && data.answers is map
             && data.answers.keys().hasAll(['q1', 'q2', 'q3', 'q4', 'q5', 'q6', 'q7', 'q8', 'q9', 'q10', 'q11'])
             && data.answers.keys().hasOnly(['q1', 'q2', 'q3', 'q4', 'q5', 'q6', 'q7', 'q8', 'q9', 'q10', 'q11'])
             && validAnswer(data.answers.q1, data.status)
             && validAnswer(data.answers.q2, data.status)
             && validAnswer(data.answers.q3, data.status)
             && validAnswer(data.answers.q4, data.status)
             && validAnswer(data.answers.q5, data.status)
             && validAnswer(data.answers.q6, data.status)
             && validAnswer(data.answers.q7, data.status)
             && validAnswer(data.answers.q8, data.status)
             && validAnswer(data.answers.q9, data.status)
             && validAnswer(data.answers.q10, data.status)
             && validAnswer(data.answers.q11, data.status);
    }
    match /users/{userId} {
      allow get: if request.auth != null
                 && request.auth.uid == userId
                 && resource.data.active == true
                 && (resource.data.role != 'student' || studentEnrollmentIsActive(resource.data));

      allow list, create, update, delete: if false;
    }

    match /classes/{classId} {
      // Administrators can review every class, including inactive classes.
      // Teachers can read only active classes explicitly assigned to their UID.
      allow get, list: if hasActiveRole('admin')
                       || (hasActiveRole('teacher')
                           && resource.data.active == true
                           && resource.data.teacherUids.hasAny([request.auth.uid]));

      match /students/{studentId} {
        // Roster access uses the current parent class, never a client role flag.
        allow get, list: if exists(/databases/$(database)/documents/classes/$(classId))
                         && (hasActiveRole('admin')
                             || (hasActiveRole('teacher')
                                 && get(/databases/$(database)/documents/classes/$(classId)).data.active == true
                                 && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUids.hasAny([request.auth.uid])));
        allow create, update, delete: if false;
        match /responses/{activityId} {
          allow get: if activityId == 'writers-effect-v1' && request.auth != null
                     && (ownsEnrollment(classId, studentId) || canReviewResponses(classId));
          allow create: if activityId == 'writers-effect-v1' && request.auth != null
                        && ownsEnrollment(classId, studentId) && validResponse(request.resource.data);
          allow update: if activityId == 'writers-effect-v1' && request.auth != null
                        && ownsEnrollment(classId, studentId) && resource.data.status == 'draft'
                        && validResponse(request.resource.data);
          allow list, delete: if false;
        }
      }

      // Class creation and assignment changes still use the Firebase Console.
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
