      let optional = optionalAnswers(activityId);
      return data.keys().hasAll(['version', 'status', 'answers', 'updatedAt'])
             && data.keys().hasOnly(['version', 'status', 'answers', 'updatedAt'])
             && data.version == 1 && data.status in ['draft', 'submitted']
             && data.updatedAt == request.time && data.answers is map
             && size > 0 && data.answers.keys().hasAll(keys) && data.answers.keys().hasOnly(keys)
             && validAnswer(data.answers.q1, optional.hasAny(['q1']) ? 'draft' : data.status)
             && (size < 2 || validAnswer(data.answers.q2, optional.hasAny(['q2']) ? 'draft' : data.status))
