                 && (answers.q31 == '' || answers.q31 in ["visibility","peatlands","borders","responsibility","smoke","outdoor"])
                 && (answers.q32 == '' || answers.q32 in ["visibility","peatlands","borders","responsibility","smoke","outdoor"])));
    }
    function validRichSubmission(answers, activityId, status) {
      return status == 'draft' || ((activityId != 'unit-8-life-choices-v1' || (answers.q16 == "Completed"
                 && answers.q17 == "Consider your values, options and possible consequences."
                 && answers.q18 == "different options may lead to different consequences."
                 && answers.q19 == "uncertainty or careful thought."))
             && (activityId != 'unit-8-decisions-v1' || (answers.q14.matches('(?s)\\s*\\S+(\\s+\\S+){119,}\\s*')
                 && answers.q15 == "Completed"
                 && answers.q16 == "Consider the options and possible outcomes."
                 && answers.q17 == "They may offer another perspective or useful information."
                 && answers.q18 == "evaluating ideas before choosing."))
             && (activityId != 'extra-reading-exam-v1' || (answers.q3 in ["Fewer students attended.\nThe average student stayed longer.","Fewer students attended.\nMore students attended.","Fewer students attended.\nThe average student stayed for less time.","The average student stayed longer.\nMore students attended.","The average student stayed longer.\nThe average student stayed for less time.","More students attended.\nThe average student stayed for less time."]
